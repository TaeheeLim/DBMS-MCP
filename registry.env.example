# registry.env 템플릿 — 이 파일을 registry.env 로 복사한 뒤 실제 값으로 채운다.
#   cp registry.env.example registry.env
# registry.env 는 비밀값이 들어가므로 git/이미지에 포함되지 않는다(.gitignore/.dockerignore).
# docker-compose.yml 의 env_file 로 컨테이너에 주입된다.

# 레지스트리 PostgreSQL 접속 문자열
#  - 호스트는 MCP 컨테이너에서 접근 가능한 PostgreSQL 서버의 IP/호스트명 (localhost 아님)
#  - 형식: postgresql://계정:비밀번호@호스트:5432/DB명
REGISTRY_PG_DSN=postgresql://mcp_reader:CHANGE_ME@10.0.0.5:5432/mcp_registry

# 비밀번호 복호화용 Fernet 키 (python migrate_json_to_pg.py --gen-key 로 생성)
#  - 마이그레이션 때 쓴 키와 반드시 동일해야 한다. 분실 시 비밀번호 복구 불가.
REGISTRY_ENC_KEY=CHANGE_ME
